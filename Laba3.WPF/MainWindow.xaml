<Window x:Class="Laba3.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Laba3.WPF"
        xmlns:core="clr-namespace:Laba3;assembly=Laba3"
        mc:Ignorable="d"
        Title="Подземелье с сокровищами" 
        Height="800" Width="1000"
        >

    <Window.Resources>
        <Style TargetType="Rectangle">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>

        <Style TargetType="Ellipse">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Новая игра" Command="{Binding NewGameCommand}"/>
                <MenuItem Header="Сохранить" Command="{Binding SaveGameCommand}"/>
                <MenuItem Header="Загрузить" Command="{Binding LoadGameCommand}"/>
                <Separator/>
                <MenuItem Header="Выход" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="Настройки">
                <MenuItem Header="Размер клетки">
                    <MenuItem Header="24px" Command="{Binding ChangeTileSizeCommand}" CommandParameter="24"/>
                    <MenuItem Header="32px" Command="{Binding ChangeTileSizeCommand}" CommandParameter="32"/>
                    <MenuItem Header="48px" Command="{Binding ChangeTileSizeCommand}" CommandParameter="48"/>
                </MenuItem>
            </MenuItem>
        </Menu>
        
        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto"
                      Background="Black">
            <Canvas x:Name="GameCanvas" 
                    Width="2000" 
                    Height="1500"
                    Background="Black">
            </Canvas>
        </ScrollViewer>
        
        <Border Grid.Row="2" 
                Background="#1E1E1E" 
                Padding="10">
            <StackPanel>
                <TextBlock x:Name="InfoText" 
                           Foreground="White" 
                           FontFamily="Consolas"
                           FontSize="14"
                           Text="{Binding PlayerInfo}"/>
                <TextBlock Text="Управление: WASD/Стрелки - движение, J - сохранить, L - загрузить, Q - выход" 
                           Foreground="LightGray" 
                           FontFamily="Consolas"
                           FontSize="12"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>

    <Window.InputBindings>
        <KeyBinding Key="W" Command="{Binding HandleInputCommand}" CommandParameter="{x:Static core:InputCommand.MoveUp}"/>
        <KeyBinding Key="Up" Command="{Binding HandleInputCommand}" CommandParameter="{x:Static core:InputCommand.MoveUp}"/>
        <KeyBinding Key="S" Command="{Binding HandleInputCommand}" CommandParameter="{x:Static core:InputCommand.MoveDown}"/>
        <KeyBinding Key="Down" Command="{Binding HandleInputCommand}" CommandParameter="{x:Static core:InputCommand.MoveDown}"/>
        <KeyBinding Key="A" Command="{Binding HandleInputCommand}" CommandParameter="{x:Static core:InputCommand.MoveLeft}"/>
        <KeyBinding Key="Left" Command="{Binding HandleInputCommand}" CommandParameter="{x:Static core:InputCommand.MoveLeft}"/>
        <KeyBinding Key="D" Command="{Binding HandleInputCommand}" CommandParameter="{x:Static core:InputCommand.MoveRight}"/>
        <KeyBinding Key="Right" Command="{Binding HandleInputCommand}" CommandParameter="{x:Static core:InputCommand.MoveRight}"/>
        <KeyBinding Key="J" Command="{Binding HandleInputCommand}" CommandParameter="{x:Static core:InputCommand.Save}"/>
        <KeyBinding Key="L" Command="{Binding HandleInputCommand}" CommandParameter="{x:Static core:InputCommand.Load}"/>
        <KeyBinding Key="Q" Command="{Binding HandleInputCommand}" CommandParameter="{x:Static core:InputCommand.Quit}"/>
        <KeyBinding Key="Escape" Command="{Binding HandleInputCommand}" CommandParameter="{x:Static core:InputCommand.Quit}"/>
    </Window.InputBindings>
</Window>
